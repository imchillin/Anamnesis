<Window x:Class="Anamnesis.SplashWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
		xmlns:gif="http://wpfanimatedgif.codeplex.com"
		xmlns:cm3="clr-namespace:Anamnesis.Styles.Controls;assembly=Styles"
		mc:Ignorable="d"
		Height="128"
		Width="128"
		ResizeMode="NoResize"
		WindowStyle="None"
		Background="Transparent"
		AllowsTransparency="True"
		Title="Starting..."
		WindowStartupLocation="CenterScreen"
		MouseDown="OnMouseDown"
		Icon="/Assets/Anamnesis.ico">


	<Grid Width="128" Height="128">

		<Ellipse Fill="#262626">
			<Ellipse.Effect>
				<DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.75"/>
			</Ellipse.Effect>
		</Ellipse>

		<ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" Foreground="White" IsIndeterminate="True" Width="128" Height="128"/>
		<Image Grid.Row="0" Source="Assets/Anamnesis.png" Width="128" Height="128" Margin="0,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"/>
	</Grid>
</Window>
