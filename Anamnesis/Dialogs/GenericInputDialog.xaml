<UserControl x:Class="Anamnesis.GUI.Dialogs.GenericInputDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
			 Width="420"
			 Loaded="OnLoaded">
	<Grid x:Name="ContentArea" Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="{Binding Message}" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0, 0, 0, 12"/>

		<TextBox Grid.Row="1" x:Name="InputBox"
				 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
				 MaxLength="{Binding MaxLength}"
				 Style="{DynamicResource MaterialDesignTextBox}"
				 KeyDown="OnKeyDown"
				 Margin="0, 0, 0, 20"/>

		<Grid Grid.Row="2">
			<Button HorizontalAlignment="Left" Margin="0" Content="{Binding Left}" Visibility="{Binding Left, Converter={StaticResource NotNullToVisibilityConverter}}" MinWidth="75" Click="OnLeftClick"/>
			<Button HorizontalAlignment="Right" Margin="0" Content="{Binding Right}" Visibility="{Binding Right, Converter={StaticResource NotNullToVisibilityConverter}}" MinWidth="75" Click="OnRightClick"/>
		</Grid>
	</Grid>
</UserControl>
