<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <AppendTargetFramework>False</AppendTargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>Anamnesis</RootNamespace>
    <ApplicationIcon>Anamnesis.ico</ApplicationIcon>
    <OutputPath>.\bin\</OutputPath>
    <DocumentationFile>.\obj\Anamnesis.xml</DocumentationFile>
    <NoWarn>1701;1702;SA1503;CS1591;SA1401;SA1516;CS0067;IDE0027;IDE0025;SA1011;SA1134;</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <TrimMode>CopyUsed</TrimMode>
    <Version>0.0.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <PublishTrimmed>false</PublishTrimmed>
    <CETCompat>false</CETCompat>
    <NeutralLanguage>en</NeutralLanguage>
    <TrimmerRootAssembly>Serilog; RemoteController</TrimmerRootAssembly>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <StartupObject>Anamnesis.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <RemoteControllerSources Include="..\RemoteController\**\*.cs" Exclude="..\RemoteController\obj\**;..\RemoteController\bin\**" />
  </ItemGroup>
  <Target Name="PublishRemoteController" BeforeTargets="ResolveProjectReferences" Inputs="$(MSBuildThisFileDirectory)..\RemoteController\RemoteController.csproj;@(RemoteControllerSources)" Outputs="$(MSBuildThisFileDirectory)..\obj\RemotePublish\RemoteController.dll">
    <Message Importance="high" Text="Changes detected in RemoteController. Publishing..." />
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\obj\RemotePublish\" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\RemoteController\RemoteController.csproj&quot; -c $(Configuration) -r win-x64 -o &quot;$(MSBuildThisFileDirectory)..\obj\RemotePublish&quot; --self-contained true --no-dependencies" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="Lumina" Version="7.6.1" />
    <PackageReference Include="Lumina.Excel" Version="7.5.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0">
      <PrivateAssets>All</PrivateAssets>
      <IncludeAssets>
      </IncludeAssets>
      <ExcludeAssets>
      </ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.*" />
    <Resource Include="Assets\Classes\*.*" />
    <Resource Include="Assets\Fonts\*.*" />
    <Resource Include="Assets\Roles\*.*" />
    <Resource Include="Assets\Shortcuts\*.*" />
    <Resource Include="Assets\Slots\*.*" />
    <Resource Include="Assets\Pose\CharFBodyBackground.png" />
    <Resource Include="Assets\Pose\CharFClothesBackground.png" />
    <Resource Include="Assets\Pose\CharFHyurFaceBackground.png" />
    <Resource Include="Assets\Pose\CharFHyurFaceExBackground.png" />
    <Resource Include="Assets\Pose\CharFMiqoFaceBackground.png" />
    <Resource Include="Assets\Pose\CharFMiqoFaceExBackground.png" />
    <Resource Include="Assets\Pose\CharFMiqoMouthBackground.png" />
    <Resource Include="Assets\Pose\CharFVieraFaceBackground.png" />
    <Resource Include="Assets\Pose\CharFVieraFaceExBackground.png" />
    <Resource Include="Assets\Pose\CharFVieraFloppyFaceBackground.png" />
    <Resource Include="Assets\Pose\CharFVieraFloppyFaceExBackground.png" />
    <Resource Include="Assets\Pose\CharHandBackground.png" />
    <Resource Include="Assets\Pose\CharMHrothFaceBackground.png" />
    <Resource Include="Assets\Pose\CharMHrothFaceExBackground.png" />
    <Resource Include="Assets\Pose\CharTailBackground.png" />
    <Resource Include="Assets\Pose\CharTongueBackground.png" />
    <Resource Include="FodyWeavers.xml" />

    <EmbeddedResource Include="Languages\*.*" />
    <EmbeddedResource Include="Data\**\*.*" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(AppData)\Anamnesis\Settings.json" Link="Settings.json" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Actor\Posing\Templates\" />
    <Folder Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lib\XivToolsWpf\XivToolsWpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lib\SharedMemoryIPC\SharedMemoryIPC\SharedMemoryIPC.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteController\RemoteController.csproj">
      <GlobalPropertiesToRemove>RuntimeIdentifier</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\obj\RemotePublish\RemoteController.dll">
      <LogicalName>Anamnesis.Memory.RemoteController.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\obj\RemotePublish\FASMX64.dll">
      <LogicalName>Anamnesis.Memory.FASMX64.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Serilog" />
    <TrimmerRootAssembly Include="RemoteController" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
</Project>