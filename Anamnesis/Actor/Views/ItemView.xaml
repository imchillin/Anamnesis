<UserControl x:Class="Anamnesis.Actor.Views.ItemView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ana="clr-namespace:Anamnesis.Styles.Controls"
			 xmlns:XivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
			 mc:Ignorable="d"
			 Margin="0"
			 d:DesignWidth="300"
			 Loaded="OnLoaded"
			 Unloaded="OnUnloaded"
			 DataContextChanged="OnDataContextChanged">

	<UserControl.Resources>
		<ControlTemplate x:Key="WeaponWarningTemplate" TargetType="Control">
			<XivToolsWpf:IconBlock HorizontalAlignment="Center" VerticalAlignment="Center"
								   Icon="ExclamationTriangle" Foreground="Orange" FontSize="20"
								   IsHitTestVisible="True" ToolTipService.ShowOnDisabled="False">
				<XivToolsWpf:IconBlock.ToolTip>
					<XivToolsWpf:TextBlock Key="Character_Equipment_WeaponOverworldWarning" />
				</XivToolsWpf:IconBlock.ToolTip>
			</XivToolsWpf:IconBlock>
		</ControlTemplate>

		<ControlTemplate x:Key="WeaponSetTemplate" TargetType="Control">
			<StackPanel Orientation="Horizontal">
				<XivToolsWpf:NumberBox Width="28" Value="{Binding ItemModel.Set}" FontSize="12" FontWeight="Light">
					<XivToolsWpf:NumberBox.ToolTip>
						<XivToolsWpf:TextBlock Key="Character_Equipment_ItemSet"/>
					</XivToolsWpf:NumberBox.ToolTip>
				</XivToolsWpf:NumberBox>

				<TextBlock Text="," Style="{StaticResource Label}" Margin="2, 2, 4, 0"/>
			</StackPanel>
		</ControlTemplate>

		<ControlTemplate x:Key="WeaponRowControlsTemplate" TargetType="Control">
			<StackPanel Orientation="Horizontal">
				<!-- Weapon Visibility -->
				<ToggleButton Height="20" Style="{StaticResource TransparentIconToggleButton}" IsChecked="{Binding ItemModel.WeaponHidden}"
							  BorderThickness="1" Padding="0" Margin="0" Visibility="{Binding IsValidWeapon, Converter={StaticResource B2V}, Mode=OneWay}">
					<ToggleButton.ToolTip>
						<XivToolsWpf:TextBlock Key="Character_Equipment_WeaponToggle"/>
					</ToggleButton.ToolTip>

					<XivToolsWpf:IconBlock Icon="EyeSlash" FontSize="10"/>
				</ToggleButton>

				<!-- Weapon Tint -->
				<ana:RgbColorControl Margin="2, 2, 0, 0" Value="{Binding ExtendedViewModel.Tint}">
					<ana:RgbColorControl.ToolTip>
						<XivToolsWpf:TextBlock Key="Character_Equipment_Tint"/>
					</ana:RgbColorControl.ToolTip>
				</ana:RgbColorControl>
			</StackPanel>
		</ControlTemplate>

		<ControlTemplate x:Key="HeadRowControlsTemplate" TargetType="Control">
			<StackPanel Orientation="Horizontal">
				<!-- Head/Hat Visibility and Visor -->
				<ToggleButton Height="20" Style="{StaticResource TransparentIconToggleButton}" IsEnabled="{Binding Actor.CanRefresh}"
							  IsChecked="{Binding Actor.DrawData.HatHidden}"
							  BorderThickness="1" Padding="0" Margin="0">
					<ToggleButton.ToolTip>
						<XivToolsWpf:TextBlock Key="Character_Equipment_HatToggle"/>
					</ToggleButton.ToolTip>

					<XivToolsWpf:IconBlock Icon="EyeSlash" FontSize="10"/>
				</ToggleButton>

				<ToggleButton Height="20" Style="{StaticResource TransparentIconToggleButton}" IsEnabled="{Binding Actor.CanRefresh}"
							  IsChecked="{Binding Actor.DrawData.VisorToggled}"
							  BorderThickness="1" Padding="0" Margin="0">
					<ToggleButton.ToolTip>
						<XivToolsWpf:TextBlock Key="Character_Equipment_VisorToggle"/>
					</ToggleButton.ToolTip>

					<XivToolsWpf:IconBlock Icon="Mask" FontSize="10"/>
				</ToggleButton>

				<ToggleButton Height="20" Style="{StaticResource TransparentIconToggleButton}" IsEnabled="{Binding Actor.CanRefresh}"
							  Visibility="{Binding SupportsEarToggle, Converter={StaticResource B2V}, Mode=OneWay}" IsChecked="{Binding Actor.DrawData.HeadgearEarsHidden}"
							  BorderThickness="1" Padding="0" Margin="0">
					<ToggleButton.ToolTip>
						<XivToolsWpf:TextBlock Key="Character_Equipment_HeadgearEarsToggle"/>
					</ToggleButton.ToolTip>

					<XivToolsWpf:IconBlock Icon="EarDeaf" FontSize="10"/>
				</ToggleButton>
			</StackPanel>
		</ControlTemplate>

		<ContextMenu x:Key="SlotContextMenu" x:Shared="False">
			<!-- Console Games Wiki -->
			<MenuItem Header="Site_OpenInConsoleGamesWiki" Click="OnOpenInConsoleGamesWikiClicked" Visibility="{Binding IsValidItemForFanSite, Converter={StaticResource B2V}, Mode=OneWay}">
				<MenuItem.Icon>
					<fa:IconImage Icon="ExternalLinkAlt" Foreground="{StaticResource PrimaryHueMidBrush}"/>
				</MenuItem.Icon>
			</MenuItem>

			<!-- Gamer Escape -->
			<MenuItem Header="Site_OpenInGamerEscape" Click="OnOpenInGamerEscapeClicked" Visibility="{Binding IsValidItemForFanSite, Converter={StaticResource B2V}, Mode=OneWay}">
				<MenuItem.Icon>
					<fa:IconImage Icon="ExternalLinkAlt" Foreground="{StaticResource PrimaryHueMidBrush}"/>
				</MenuItem.Icon>
			</MenuItem>

			<!-- Garland Tools -->
			<MenuItem Header="Site_OpenInGarlandTools" Click="OnOpenInGarlandToolsClicked" Visibility="{Binding IsValidItemForFanSite, Converter={StaticResource B2V}, Mode=OneWay}">
				<MenuItem.Icon>
					<fa:IconImage Icon="ExternalLinkAlt" Foreground="{StaticResource PrimaryHueMidBrush}"/>
				</MenuItem.Icon>
			</MenuItem>

			<Separator Visibility="{Binding IsValidItemForFanSite, Converter={StaticResource B2V}}"/>

			<!-- Copy Item Name -->
			<MenuItem Header="Item_CopyName" Click="OnCopyItemNameClicked" Visibility="{Binding IsValidItemForCopy, Converter={StaticResource B2V}, Mode=OneWay}">
				<MenuItem.Icon>
					<Image Source="{Binding Item.Icon, Converter={StaticResource Img}}"/>
				</MenuItem.Icon>
			</MenuItem>

			<!-- Reset Slot -->
			<MenuItem Header="Item_ResetSlot" Click="OnResetSlotClicked">
				<MenuItem.Icon>
					<fa:IconImage Icon="UndoAlt" Foreground="{StaticResource PrimaryHueMidBrush}"/>
				</MenuItem.Icon>
			</MenuItem>

			<!-- Clear Slot -->
			<MenuItem Header="Item_ClearSlot" Click="OnClearSlotClicked">
				<MenuItem.Icon>
					<fa:IconImage Icon="Circle" Foreground="{StaticResource PrimaryHueMidBrush}"/>
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>

		<ContextMenu x:Key="DyeContextMenu" x:Shared="False">
			<MenuItem Header="Character_Equipment_SwapDyeChannels" Click="OnSwapDyeChannels">
				<MenuItem.Icon>
					<fa:IconImage Icon="ArrowRightArrowLeft" Foreground="{StaticResource PrimaryHueMidBrush}"/>
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Click="OnToggleLinkDyes" Visibility="{Binding IsWeapon, Converter={StaticResource B2V}, Mode=OneWay}">
				<MenuItem.Header>
					<Grid>
						<XivToolsWpf:TextBlock Key="EquipmentSelector_UnlinkDyes" Visibility="{Binding LinkWeaponDyes, Converter={StaticResource B2V}}"/>
						<XivToolsWpf:TextBlock Key="EquipmentSelector_LinkDyes" Visibility="{Binding LinkWeaponDyes, Converter={StaticResource !B2V}}"/>
					</Grid>
				</MenuItem.Header>
				<MenuItem.Icon>
					<Grid>
						<fa:IconImage Icon="Unlink" Foreground="{StaticResource PrimaryHueMidBrush}" Visibility="{Binding LinkWeaponDyes, Converter={StaticResource B2V}}"/>
						<fa:IconImage Icon="Link" Foreground="{StaticResource PrimaryHueMidBrush}" Visibility="{Binding LinkWeaponDyes, Converter={StaticResource !B2V}}"/>
					</Grid>
				</MenuItem.Icon>
			</MenuItem>
		</ContextMenu>
	</UserControl.Resources>

	<GroupBox Margin="3, 0" x:Name="ContentArea">
		<GroupBox.Header>
			<Grid MaxWidth="150">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				
				<TextBlock Grid.Column="0" Text="{Binding SlotName}" FontWeight="Light" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
				<TextBlock Grid.Column="1" Text=":" Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
				<TextBlock Grid.Column="2" Text="{Binding Item.Name}" Margin="4, 0, 0, 0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
					<TextBlock.ToolTip>
						<StackPanel>
							<TextBlock Text="{Binding Item.Name}" FontWeight="DemiBold"/>
							<TextBlock Text="{Binding Item.Description}" Visibility="{Binding Item.Description, Converter={StaticResource StringHasContentToVisibility}}"/>
						</StackPanel>
					</TextBlock.ToolTip>
				</TextBlock>
			</Grid>
		</GroupBox.Header>

		<Grid Margin="0, 2, 0, 0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition/>
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Grid.RowSpan="2" IsEnabled="{Binding Actor.CanRefresh, Mode=OneWay}">
				<Button Width="48" Height="48" Click="OnClick" MouseUp="OnSlotMouseUp"
						Style="{DynamicResource TransparentButton}" IsEnabled="{Binding CanEditItem, Mode=OneWay}">
					<Grid ContextMenuOpening="OnSlotContextMenuOpening">
						<Image x:Name="SlotIcon" Source="{Binding IconSource}" Margin="6" Opacity="0.3"/>

						<Grid Visibility="{Binding ItemModel, Converter={StaticResource NotNullToVisibilityConverter}}">
							<Image Source="{Binding Item.Icon, Converter={StaticResource Img}}" Margin="2"/>
							<Image Source="/Assets/IconOverlay.png" Margin="2"
								   Visibility="{Binding Item.Icon, Converter={StaticResource NotNullToVisibilityConverter}, Mode=OneWay}"/>
						</Grid>

						<Grid.ToolTip>
							<StackPanel>
								<TextBlock Text="{Binding Item.Name}" FontWeight="DemiBold"/>
								<TextBlock Text="{Binding Item.Description}"
										   Visibility="{Binding Item.Description, Converter={StaticResource StringHasContentToVisibility}, Mode=OneWay}" />
								<XivToolsWpf:TextBlock Key="Character_Equipment_MiddleClickToClear" Visibility="{Binding Item.Icon, Converter={StaticResource NotNullToVisibilityConverter}, Mode=OneWay}"/>
							</StackPanel>
						</Grid.ToolTip>
						<Grid.ContextMenu>
							<ContextMenu/>
						</Grid.ContextMenu>
					</Grid>
				</Button>

				<Control Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"
						 Visibility="{Binding ShowWeaponWarning, Converter={StaticResource B2V}, Mode=OneWay}">
					<Control.Style>
						<Style TargetType="Control">
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowWeaponWarning}" Value="True">
									<Setter Property="Template" Value="{StaticResource WeaponWarningTemplate}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Control.Style>
				</Control>
			</Grid>

			<ProgressBar IsIndeterminate="{Binding IsLoading, Mode=OneWay}" Style="{StaticResource MaterialDesignCircularProgressBar}" Grid.Row="0" Grid.RowSpan="2"
						 Visibility="{Binding IsLoading, Converter={StaticResource B2V}, Mode=OneWay}"/>

			<StackPanel Grid.Row="0" Grid.Column="1" Margin="3,0,0,0" Orientation="Horizontal" IsEnabled="{Binding Actor.CanRefresh, Mode=OneWay}">
				<StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditItem, Mode=OneWay}">
					<Control Focusable="False">
						<Control.Style>
							<Style TargetType="Control">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsWeapon}" Value="True">
										<Setter Property="Template" Value="{StaticResource WeaponSetTemplate}"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Control.Style>
					</Control>

					<XivToolsWpf:NumberBox Width="28" Value="{Binding ItemModel.Base}" FontSize="12" FontWeight="Light">
						<XivToolsWpf:NumberBox.ToolTip>
							<XivToolsWpf:TextBlock Key="Character_Equipment_ItemBase"/>
						</XivToolsWpf:NumberBox.ToolTip>
					</XivToolsWpf:NumberBox>

					<TextBlock Text="," Style="{StaticResource Label}" Margin="2, 2, 4, 0" />
					<XivToolsWpf:NumberBox Width="28" Value="{Binding ItemModel.Variant}" FontSize="12" FontWeight="Light">
						<XivToolsWpf:NumberBox.ToolTip>
							<XivToolsWpf:TextBlock Key="Character_Equipment_ItemVariant"/>
						</XivToolsWpf:NumberBox.ToolTip>
					</XivToolsWpf:NumberBox>
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="2, 0, 0, 0" Orientation="Horizontal"
						Visibility="{Binding CanDye, Converter={StaticResource B2V}}">
				<Control Focusable="False">
					<Control.Style>
						<Style TargetType="Control">
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsWeapon}" Value="True">
									<Setter Property="Template" Value="{StaticResource WeaponRowControlsTemplate}"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding IsHead}" Value="True">
									<Setter Property="Template" Value="{StaticResource HeadRowControlsTemplate}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Control.Style>
				</Control>

				<!-- Dye -->
				<Button MouseUp="OnDyeMouseUp" Margin="2, 4, 0, 0" Grid.Column="0" Grid.RowSpan="2" Click="OnDyeClick"
						ContextMenuOpening="OnDyeContextMenuOpening"
						Height="20" Width="20" VerticalAlignment="Top" Style="{DynamicResource TransparentButton}"
						IsEnabled="{Binding Actor.CanRefresh, Mode=OneWay}">

					<Grid>
						<Grid Visibility="{Binding ItemModel, Converter={StaticResource NotNullToVisibilityConverter}}">
							<Image Source="{Binding Dye.Icon, Converter={StaticResource Img}}" Margin="2"/>
							<Image Source="/Assets/IconOverlay.png" Margin="2" Visibility="{Binding Dye.Icon, Converter={StaticResource NotNullToVisibilityConverter}}"/>
							<fa:IconBlock Opacity="0.2" Foreground="{DynamicResource MaterialDesignBodyLight}" Icon="_1" Visibility="{Binding Dye.Icon, Converter={StaticResource NullToVisibilityConverter}}"/>

							<Grid.ToolTip>
								<StackPanel>
									<StackPanel Orientation="Horizontal">
										<XivToolsWpf:TextBlock Key="Character_Equipment_DyeN" Value="1"/>
										<TextBlock Text=": "/>
										<TextBlock Text="{Binding Dye.Name}" FontWeight="DemiBold"/>
									</StackPanel>
									<XivToolsWpf:TextBlock Key="Character_Equipment_MiddleClickToClear" Visibility="{Binding Dye.Icon, Converter={StaticResource NotNullToVisibilityConverter}}"/>
								</StackPanel>
							</Grid.ToolTip>
						</Grid>
					</Grid>

					<Button.ContextMenu>
						<ContextMenu/>
					</Button.ContextMenu>
				</Button>
				<Button MouseUp="OnDye2MouseUp" Margin="2, 4, 0, 0" Grid.Column="0" Grid.RowSpan="2" Click="OnDyeClick2" VerticalAlignment="Top"
						ContextMenuOpening="OnDyeContextMenuOpening"
						Height="20" Width="20" Style="{DynamicResource TransparentButton}" IsEnabled="{Binding Actor.CanRefresh, Mode=OneWay}">

					<Grid>
						<Grid Visibility="{Binding ItemModel, Converter={StaticResource NotNullToVisibilityConverter}, Mode=OneWay}">
							<Image Source="{Binding Dye2.Icon, Converter={StaticResource Img}}" Margin="2"/>
							<Image Source="/Assets/IconOverlay.png" Margin="2" Visibility="{Binding Dye2.Icon, Converter={StaticResource NotNullToVisibilityConverter}, Mode=OneWay}"/>
							<fa:IconBlock Opacity="0.2" Foreground="{DynamicResource MaterialDesignBodyLight}" Icon="_2" Visibility="{Binding Dye2.Icon, Converter={StaticResource NullToVisibilityConverter}}"/>

							<Grid.ToolTip>
								<StackPanel>
									<StackPanel Orientation="Horizontal">
										<XivToolsWpf:TextBlock Key="Character_Equipment_DyeN" Value="2"/>
										<TextBlock Text=": "/>
										<TextBlock Text="{Binding Dye2.Name}" FontWeight="DemiBold"/>
									</StackPanel>
									<XivToolsWpf:TextBlock Key="Character_Equipment_MiddleClickToClear" Visibility="{Binding Dye2.Icon, Converter={StaticResource NotNullToVisibilityConverter}}"/>
								</StackPanel>
							</Grid.ToolTip>
						</Grid>
					</Grid>

					<Button.ContextMenu>
						<ContextMenu/>
					</Button.ContextMenu>
				</Button>
			</StackPanel>

			<ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="-5,2,-3,-2"
							Visibility="{Binding IsValidWeapon, Converter={StaticResource B2V}, Mode=OneWay}">
				<ContentControl.Style>
					<Style TargetType="ContentControl">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsValidWeapon}" Value="True">
								<Setter Property="Content" Value="{Binding ExtendedViewModel}"/>
								<Setter Property="ContentTemplate">
									<Setter.Value>
										<DataTemplate>
											<ana:VectorEditor Value="{Binding Transform.Scale}" Minimum="0" Maximum="float.MaxValue" TickFrequency="0.01"
															  DefaultValue="1" CanLink="True" Linked="True" SliderMode="Relative"
															  DecimalPlaces="{Binding Settings.SliderPrecision, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
															  ShowSliderThumb="{Binding Settings.ShowSliderThumb, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
															  LayoutStyle="Compact" EnableStepButtons="True"
															  SliderType="{Binding Settings.BoneScaleSliderType, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
										</DataTemplate>
									</Setter.Value>
								</Setter>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ContentControl.Style>
			</ContentControl>
		</Grid>
	</GroupBox>
</UserControl>
