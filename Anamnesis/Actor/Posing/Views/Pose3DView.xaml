<UserControl
	x:Class="Anamnesis.Actor.Views.Pose3DView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views="clr-namespace:Anamnesis.Actor.Views"
	xmlns:XivToolsWpf="clr-namespace:XivToolsWpf.Controls;assembly=XivToolsWpf"
	d:DesignHeight="512"
	d:DesignWidth="1024"
	DataContextChanged="OnDataContextChanged"
	Loaded="OnLoaded"
	Unloaded="OnUnloaded"
	PreviewKeyDown="OnPreviewKeyDown"
	mc:Ignorable="d">

	<Grid x:Name="ContentArea">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="183" />
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="0"
				  Background="Transparent"
				  MouseWheel="OnViewportMouseWheel"
				  MouseDown="OnViewportMouseDown"
				  MouseMove="OnViewportMouseMove"
				  MouseUp="OnViewportMouseUp"
				  MouseLeave="OnViewportMouseLeave">

				<StackPanel IsEnabled="True"
							Orientation="Horizontal"
							Margin="130, 0, 0, 0"
							VerticalAlignment="Top">

					<Button Padding="6,2"
							Margin="3"
							Click="OnResetCameraButtonClicked"
							Content="Reset Camera"
							Style="{StaticResource TransparentButton}" />

					<CheckBox x:Name="FollowInGameCameraCheckbox"
							  Margin="5,0,3,0"
							  VerticalContentAlignment="Center"
							  IsChecked="{Binding SyncWithGameCamera}">

						<XivToolsWpf:TextBlock Key="Pose_SyncWithGameCamera" Margin="0, 0, 0, 3" />

						<CheckBox.ToolTip>
							<XivToolsWpf:TextBlock Key="Pose_SyncWithGameCamera_Tooltip" />
						</CheckBox.ToolTip>
					</CheckBox>
				</StackPanel>

				<Viewport3D x:Name="Viewport">
					<ModelVisual3D>
						<ModelVisual3D.Content>
							<Model3DGroup>
								<AmbientLight Color="White" />
							</Model3DGroup>
						</ModelVisual3D.Content>
					</ModelVisual3D>

					<ModelVisual3D x:Name="SkeletonRoot" />
				</Viewport3D>

				<Canvas x:Name="OverlayCanvas" ClipToBounds="True">
					<Border x:Name="BoneMenuBorder"
							Visibility="Collapsed"
							Background="{DynamicResource MaterialDesignPaper}"
							BorderBrush="{DynamicResource MaterialDesignDivider}"
							BorderThickness="1.5"
							CornerRadius="6"
							Padding="3"
							MinWidth="180"
							MaxWidth="300"
							PreviewMouseMove="OnMenuPreviewMouseMove"
							PreviewMouseWheel="OnMenuPreviewMouseWheel">
						<Border.Effect>
							<DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.5"/>
						</Border.Effect>

						<ListBox x:Name="BoneMenuList"
								 Background="Transparent"
								 BorderThickness="0"
								 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								 ScrollViewer.VerticalScrollBarVisibility="Auto"
								 MaxHeight="220"
								 SelectionMode="Single">
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="Padding" Value="8,5"/>
									<Setter Property="Margin" Value="1"/>
									<Setter Property="Cursor" Value="Hand"/>
									<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListBoxItem">
												<Border x:Name="ItemBorder"
														CornerRadius="4"
														Padding="{TemplateBinding Padding}"
														Background="Transparent"
														SnapsToDevicePixels="True">
													<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
																	  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
													</Trigger>
													<Trigger Property="IsSelected" Value="True">
														<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
														<Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<EventSetter Event="MouseEnter" Handler="OnBoneMenuItemMouseEnter"/>
									<EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnBoneMenuItemClick"/>
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid Margin="2,1">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Ellipse x:Name="BoneDot"
												 Grid.Column="0"
												 Width="7"
												 Height="7"
												 Margin="2,0,8,0"
												 Fill="{DynamicResource PrimaryHueMidBrush}"
												 VerticalAlignment="Center"/>
										<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
											<TextBlock Text="{Binding Tooltip}" FontWeight="Medium" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding Name, StringFormat=' ({0})'}" FontSize="10" Opacity="0.6" Margin="4,0,0,0" VerticalAlignment="Center"/>
										</StackPanel>
									</Grid>
									<DataTemplate.Triggers>
										<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
											<Setter TargetName="BoneDot" Property="Fill" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>
				</Canvas>
			</Grid>

			<Grid Grid.Column="1" Grid.RowSpan="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition/>
				</Grid.RowDefinitions>
				<TextBox Grid.Row="0" Text="{Binding BoneSearch, UpdateSourceTrigger=PropertyChanged}" Margin="6" Style="{StaticResource MaterialDesignTextBox}"/>
				<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding BoneSearchResult}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="32" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>

									<views:BoneView Grid.Column="0" />

									<XivToolsWpf:TextBlock Grid.Column="1"
														   VerticalAlignment="Center"
														   FontSize="11"
														   FontWeight="Light"
														   Text="{Binding Tooltip}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
